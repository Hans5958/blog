---
import { Image } from "astro:assets";
import type { ComponentProps } from "astro/types";

interface Props extends ComponentProps<typeof Image> {
	figureClass?: string;
	figureId?: string;
	figureStyle?: string | Record<string, any>;
}

const {
	figureClass,
	figureId,
	figureStyle,
	class: imgClass,
	style: imgStyle,
	alt,
	...imageProps
} = Astro.props;

const hasCaption = typeof alt === "string" && alt.trim().length > 0;
---

<figure class={figureClass} id={figureId} style={figureStyle}>
	<Image {...imageProps} alt={alt ?? ""} class={imgClass} style={imgStyle} />
	{hasCaption && <figcaption>{alt}</figcaption>}
</figure>
